{
  "name": "street-tree-equity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Street Tree Equity Map: OSM trees per acre by US Census tract. 100% free, static-data, no API keys.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "data:refresh": "node scripts/build-data.mjs --refresh",
    "serve": "node server/index.mjs",
    "start": "npm run build && npm run serve",
    "typecheck": "vue-tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "express": "^4.21.2",
    "maplibre-gl": "^5.6.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@turf/turf": "^7.2.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "adm-zip": "^0.5.16",
    "osmtogeojson": "^3.0.0-beta.5",
    "shapefile": "^0.6.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-vuetify": "^2.1.1",
    "vue-tsc": "^2.2.10"
  }
}
